# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit a filled-in .env — it is gitignored.
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ---------------------------------------------------------------------------

# --- Core Django -----------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# Where the SPA runs, so the browser is allowed to call the API with cookies.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- Database --------------------------------------------------------------
# Leave blank to use a local SQLite file under var/ (fine for a first run).
# With docker compose up: postgres://aivideo:aivideo@localhost:5432/aivideo
DATABASE_URL=

# --- Queue -----------------------------------------------------------------
# Leave blank to run renders inline, in-process (no worker needed).
# With docker compose up: redis://localhost:6379/0
REDIS_URL=

# --- Object storage --------------------------------------------------------
# Leave AWS_STORAGE_BUCKET_NAME blank to store uploads on local disk.
# For the bundled MinIO service:
#   AWS_STORAGE_BUCKET_NAME=aivideo
#   AWS_S3_ENDPOINT_URL=http://localhost:9000
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
#   AWS_S3_ADDRESSING_STYLE=path
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_S3_URL_EXPIRE_SECONDS=900

# --- Authentication --------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# Set to true once you serve the app over HTTPS.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax

# --- Media limits (these are your cost controls) ---------------------------
MAX_UPLOAD_BYTES=536870912
MAX_UPLOAD_DURATION_SECONDS=600
MAX_OUTPUT_DURATION_SECONDS=600
MAX_STORAGE_BYTES_PER_USER=5368709120
MAX_EXPORTS_PER_DAY=50
MAX_CONCURRENT_RENDERS_PER_USER=2
RENDER_PROCESS_TIMEOUT_SECONDS=3000

# --- Rate limits -----------------------------------------------------------
THROTTLE_AUTH=20/hour
THROTTLE_UPLOAD=30/hour
THROTTLE_RENDER=60/hour
THROTTLE_READ=2000/hour

# --- FFmpeg ----------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# --- AI provider (Phase 2; disabled until configured) ----------------------
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_MAX_CALLS_PER_USER_PER_DAY=20

# --- Social publishing (Phase 3; nothing works until these are real) -------
# Each platform requires its own developer app and review/approval process.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:5173
